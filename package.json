{
  "name": "kea",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "guard": "node scripts/assert-kea-isolation.mjs",
    "build": "npm run guard && npm run seo:files && tsc -b && vite build && npm run seo:routes",
    "seo:files": "node --experimental-strip-types scripts/write-kea-seo-files.mjs",
    "seo:routes": "node --experimental-strip-types scripts/write-kea-route-html.mjs",
    "lint": "oxlint",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "kea:auth-emails": "node scripts/kea-auth-emails.mjs && node scripts/kea-sync-auth-emails.mjs",
    "kea:supabase": "node scripts/kea-cli.mjs supabase",
    "kea:netlify": "node scripts/kea-cli.mjs netlify",
    "kea:github": "node scripts/kea-cli.mjs github",
    "cap:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:bundle": "npm run cap:sync && node scripts/kea-android-bundle.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
